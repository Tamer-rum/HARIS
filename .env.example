APP_NAME=HARIS
ENVIRONMENT=demo
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
CYCLE_SECONDS=60
ENABLE_CONTINUOUS_LOOP=false
# A continuous loop never writes live state unless this additional explicit flag is true.
ENABLE_LIVE_WRITE_LOOP=false

# fixture = full deterministic demo; live_read_only = Nokia telemetry only;
# live_write = Nokia writes only after WARDEN validates operator resources.
# Legacy value "live" safely maps to live_read_only.
NAC_MODE=fixture
NAC_API_TOKEN=
NAC_BASE_URL=https://networkascode.nokia.io
FIXTURE_DIR=fixtures

# Required only when enabling the corresponding live mutations.
NAC_GEOFENCE_SINK=
# Example JSON: {"storm-impact":{"latitude":24.7136,"longitude":46.6753,"radius_m":5000}}
NAC_GEOFENCE_AREAS={}
NAC_GEOFENCE_EVENT_TYPES=["org.camaraproject.geofencing-subscriptions.v0.area-entered","org.camaraproject.geofencing-subscriptions.v0.area-left"]
NAC_GEOFENCE_EXPIRY_SECONDS=300
NAC_QOD_PROFILE_MAP={}
NAC_QOD_SERVICE_IPV4=
NAC_QOD_SINK=
NAC_EMERGENCY_SLICE_ID=
# Optional JSON map for any additional HARIS policy aliases: {"policy-alias":"operator-slice-id"}
NAC_SLICE_ID_MAP={}

# Sensitive identity/dispatch flow: isolated from fixture network operations.
# Set only in the deployed callback service; never commit real values.
NAC_NUMBER_VERIFICATION_REDIRECT_URI=
NAC_NUMBER_VERIFICATION_SCOPE=dpv:FraudPreventionAndDetection number-verification:verify
TRUSTED_DISPATCH_VERIFICATION_TTL_SECONDS=300
TRUSTED_DISPATCH_SIM_SWAP_WINDOW_SECONDS=86400

GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

SUPABASE_URL=
SUPABASE_KEY=
MEM0_API_KEY=
PUBLIC_DUST_FEED_URL=
OPERATOR_TENANT=haris-demo
